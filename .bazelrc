# Bazel configuration file

# Autoloading configurations for compatibility with Bazel 9.x
build --incompatible_autoload_externally=cc_library,cc_binary,cc_test,py_test,py_binary,py_library,proto_library

# Disable module maps and layering checks which cause compiler conflicts on macOS/Xcode
build --features=-layering_check,-use_header_modules,-module_maps
build --host_features=-layering_check,-use_header_modules,-module_maps

# Target macOS 11.0 (Big Sur) minimum by default for macOS targets (earliest arm64 macOS release)
build --macos_minimum_os=11.0

# Propagate Xcode developer directory environment variable for hermetic compiler/SDK paths matching
build --action_env=DEVELOPER_DIR
build --host_action_env=DEVELOPER_DIR

# Set C++17 standard (to avoid C++20 strict template-id destructor errors in gRPC)
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17

# Speed up build by compiling host tools in fastbuild mode instead of opt mode
build --host_compilation_mode=fastbuild

# Enable disk caching to persist build artifacts across builds
build --disk_cache=/Users/jeremyarcher/.cache/bazel-disk-cache

# Optimize caching across different workspace paths (e.g. Git worktrees / subagents)
build --features=oso_prefix_is_pwd
build --experimental_output_paths=strip
build --incompatible_strict_action_env

# rules_fuzzing configuration
build:asan-libfuzzer --@rules_fuzzing//fuzzing:cc_engine=@rules_fuzzing//fuzzing/engines:libfuzzer
build:asan-libfuzzer --@rules_fuzzing//fuzzing:cc_engine_instrumentation=libfuzzer
build:asan-libfuzzer --@rules_fuzzing//fuzzing:cc_engine_sanitizer=asan

